<%= form_with(model: task, id: "new_task_form", class: "task-form") do |form| %>
  <% if task.errors.any? %>
    <div class="form-errors">
      <p><%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:</p>
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.text_field :title, placeholder: "What needs to be done?", class: "task-input", autofocus: true %>
    <%= form.submit "Add Task", class: "btn btn-primary" %>
  </div>
<% end %>
